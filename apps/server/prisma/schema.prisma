generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String     @id @default(cuid())
  name            String?
  email           String?    @unique
  password        String?
  address         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now())
  isActive        Boolean    @default(false)
  isEmailVerified Boolean    @default(false)
  isPhoneVerified Boolean    @default(false)
  isVerified      Boolean    @default(false)
  isDeleted       Boolean    @default(false)
  lastLogin       DateTime?
  phoneNumber     String     @unique
  totalLogins     Int        @default(0)
  bio             String?
  city            String?
  country         String?    @default("Bangladesh")
  coveragePicture String?
  dateOfBirth     DateTime?  @default(now())
  gender          String?
  postalCode      String?
  profilePicture  String?
  thana           String?
  totalOrders     Int        @default(0)
  orders          Order[]
  otps            Otp[]
  userRoles       UserRole[]

  @@map("users")
}

model Otp {
  id        String   @id @default(cuid())
  userId    String
  type      OtpType
  target    String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([target, code])
  @@map("otps")
}

model Role {
  id        String     @id @default(cuid())
  name      RoleType   @unique
  isDelete  Boolean    @default(false)
  createdAt DateTime   @default(now())
  users     UserRole[]

  @@map("roles")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Collection {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  isActive             Boolean              @default(true)
  isDelete             Boolean              @default(false)
  isHomeShow           Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  collectionCategories CollectionCategory[]
  productCollections   ProductCollection[]
}

model Category {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  isDelete              Boolean               @default(false)
  isActive              Boolean               @default(true)
  categorySubCategories CategorySubCategory[]
  collectionCategories  CollectionCategory[]
  productCategories     ProductCategory[]
}

model CollectionCategory {
  collectionId String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  collection   Collection @relation(fields: [collectionId], references: [id])

  @@id([collectionId, categoryId])
}

model SubCategory {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  isDelete              Boolean               @default(false)
  categorySubCategories CategorySubCategory[]
  productSubCategories  ProductSubCategory[]
}

model CategorySubCategory {
  categoryId    String
  subCategoryId String
  category      Category    @relation(fields: [categoryId], references: [id])
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@id([categoryId, subCategoryId])
}

model Brand {
  id        String    @id @default(uuid())
  title     String
  slug      String    @unique
  isDelete  Boolean   @default(false)
  isPublish Boolean   @default(false)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  image     String?
  order     Int       @default(1)
  products  Product[]

  @@index([isPublish, isDelete])
  @@map("brands")
}

model Banner {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String?
  image       String?
  isDelete    Boolean     @default(false)
  isPublish   Boolean     @default(false)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)
  isSide      Boolean     @default(false)
  link        String?
  type        BannerType? @default(IMAGE)
  video       String?

  @@map("banners")
}

model Product {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  title                String
  modelNumber          String
  description          String
  features             Json?
  brandId              String
  price                Decimal              @db.Decimal(10, 2)
  basePrice            Decimal              @db.Decimal(10, 2)
  discount             Int                  @default(0)
  prebookPrice         Decimal?             @db.Decimal(10, 2)
  deliveryCharge       Decimal?             @db.Decimal(10, 2)
  ratings              Float                @default(0)
  reviewsCount         Int                  @default(0)
  sold                 Int                  @default(0)
  view                 Int                  @default(0)
  condition            ProductCondition     @default(BRAND_NEW)
  type                 ProductType          @default(ORGANIC_FOOD)
  isDeleted            Boolean              @default(false)
  isPublish            Boolean              @default(false)
  expiryDate           DateTime?
  ingredients          String?
  nutritionInfo        String?
  isDigital            Boolean              @default(false)
  author               String?
  publisher            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  digitalFiles         DigitalFile[]
  orderItems           OrderItem[]
  brand                Brand                @relation(fields: [brandId], references: [id])
  typeId               String?
  typeEntity           ProductTypeEntity?   @relation(fields: [typeId], references: [id])
  productCategories    ProductCategory[]
  productCollections   ProductCollection[]
  productColors        ProductColor[]
  productFeatures      ProductFeature[]
  productImages        ProductImage[]
  productInventories   ProductInventory[]
  productOptionGroups  ProductOptionGroup[]
  productSubCategories ProductSubCategory[]

  @@index([price])
  @@index([brandId])
  @@index([isPublish, isDeleted])
}

model ProductInventory {
  id        String  @id @default(cuid())
  productId String
  quantity  Int
  product   Product @relation(fields: [productId], references: [id])

  @@index([productId])
}

model ProductColor {
  id         String         @id @default(cuid())
  productId  String
  name       String
  hexCode    String?
  stock      Int            @default(0)
  basePrice  Decimal        @db.Decimal(10, 2)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  isPublish  Boolean        @default(true)
  orderItems OrderItem[]
  product    Product        @relation(fields: [productId], references: [id])
  images     ProductImage[]

  @@index([productId])
}

model ProductOptionGroup {
  id        String            @id @default(cuid())
  productId String
  title     String
  type      ProductOptionType
  isPublish Boolean           @default(true)
  isDeleted Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  options   ProductOption[]
  product   Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([type])
}

model ProductOption {
  id               String             @id @default(cuid())
  groupId          String
  value            String
  extraPrice       Decimal            @db.Decimal(10, 2)
  isPublish        Boolean            @default(true)
  isDeleted        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  orderItemOptions OrderItemOption[]
  group            ProductOptionGroup @relation(fields: [groupId], references: [id])

  @@index([groupId])
}

model ProductImage {
  id        String        @id @default(cuid())
  productId String
  url       String
  altText   String?
  isPrimary Boolean       @default(false)
  sortOrder Int           @default(0)
  isDeleted Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  colorId   String?
  color     ProductColor? @relation(fields: [colorId], references: [id])
  product   Product       @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductFeature {
  id        String      @id @default(cuid())
  productId String
  title     String?
  image     String?
  features  Json?
  sortOrder Int         @default(0)
  type      FeatureType @default(HIGHLIGHT)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  product   Product     @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([productId, sortOrder])
}

model ProductCollection {
  productId    String
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id])
  product      Product    @relation(fields: [productId], references: [id])

  @@id([productId, collectionId])
  @@index([collectionId])
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductSubCategory {
  productId     String
  subCategoryId String
  product       Product     @relation(fields: [productId], references: [id])
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])

  @@id([productId, subCategoryId])
  @@index([subCategoryId])
}

model Order {
  id            String        @id @default(cuid())
  traxId        String        @unique
  userId        String
  name          String
  email         String?
  phoneNumber   String
  address       String
  totalAmount   Decimal       @db.Decimal(10, 2)
  discount      Decimal?      @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  promoCodeId    String?
  deliveryZoneId String?
  deliveryCharge Decimal?      @default(0) @db.Decimal(10, 2)
  type           PaymentMethod @default(CASH_ON_DELIVERY)
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  promoCode      PromoCode?    @relation(fields: [promoCodeId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]
  transactions  Transaction[]
}

model OrderItem {
  id        String            @id @default(cuid())
  orderId   String
  traxId    String            @unique
  productId String
  colorId   String?
  quantity  Int
  price     Decimal           @db.Decimal(10, 2)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  color     ProductColor?     @relation(fields: [colorId], references: [id])
  order     Order             @relation(fields: [orderId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])
  options   OrderItemOption[]
}

model OrderItemOption {
  id          String        @id @default(cuid())
  orderItemId String
  optionId    String
  optionValue String?
  extraPrice  Decimal       @db.Decimal(10, 2)
  option      ProductOption @relation(fields: [optionId], references: [id])
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

model Transaction {
  id            String        @id @default(cuid())
  orderId       String
  traxId        String        @unique
  status        PaymentStatus
  amount        Decimal       @db.Decimal(10, 2)
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  type          PaymentMethod @default(CASH_ON_DELIVERY)
  order         Order         @relation(fields: [orderId], references: [id])
}

model PromoCode {
  id           String    @id @default(cuid())
  code         String    @unique
  discount     Decimal   @db.Decimal(10, 2)
  type         PromoType @default(FLAT)
  isActive     Boolean   @default(true)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  isDeleted    Boolean   @default(false)
  perUserLimit Int?      @default(1)
  usageLimit   Int?
  usedCount    Int       @default(0)
  orders       Order[]
}

model Content {
  id          String   @id @default(cuid())
  title       String
  description String?
  number      Int?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contents")
}

model ProductTypeEntity {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model DeliveryZone {
  id             String   @id @default(cuid())
  name           String
  area           String?
  deliveryCharge Decimal  @default(0) @db.Decimal(10, 2)
  estimatedTime  String?
  isActive       Boolean  @default(true)
  isDelete       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  orders         Order[]

  @@map("delivery_zones")
}

model DigitalFile {
  id        String   @id @default(cuid())
  productId String
  fileName  String
  filePath  String
  fileSize  Int
  mimeType  String   @default("application/pdf")
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])

  @@map("digital_files")
}

enum PaymentMethod {
  ONLINE_PAYMENT
  CASH_ON_DELIVERY
  BKASH_MANUAL
  NAGAD_MANUAL
}

enum PromoType {
  FLAT
  PERCENT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum RoleType {
  USER
  ADMIN
  SUPER_ADMIN
  SELLER
  MODERATOR
}

enum OtpType {
  EMAIL_LOGIN
  PHONE_LOGIN
  PASSWORD_RESET
}

enum BannerType {
  IMAGE
  VIDEO
}

enum ProductCondition {
  BRAND_NEW
  PRE_OWNED
  FRESH
  PACKAGED
  HANDMADE
  PRINTED
  DIGITAL
}

enum ProductType {
  LAPTOP
  ACCESSORY
  ORGANIC_FOOD
  EDUCATION_MATERIAL
  GENERAL
}

enum FeatureType {
  HIGHLIGHT
  SPECIFICATION
}

enum ProductOptionType {
  RAM
  STORAGE
  KEYBOARD
  WEIGHT
  VOLUME
  EDITION
  CLASS
}
