# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Server Configuration
PORT=5000
NODE_ENV=production
BACKEND_URL=http://localhost:5000

# Authentication
JWT_ACCESS_SECRET=your_jwt_secret_key_here

# SMS Gateway (for Mobile OTP)
SMS_TOKEN=your_sms_gateway_token
SMS_URL=https://api.sms-provider.com/send

# S3 / Cloudflare R2 File Storage
END_POINT=https://<account-id>.r2.cloudflarestorage.com
BUCKET_NAME=prism-bazar
ACCESS_KEY_ID=your_r2_access_key
SECRET_ACCESS_KEY=your_r2_secret_key
FILE_URL=https://pub-your-id.r2.dev

# Order Redirect URLs
SUCCESS_URL=http://localhost:3000/success
FAIL_URL=http://localhost:3000/fail
CANCEL_URL=http://localhost:3000/cancel
